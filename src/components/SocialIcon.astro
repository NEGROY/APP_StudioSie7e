---
const { network } = Astro.props;
---
{
  network === "facebook" ? (
    <svg class="social-brand-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="currentColor" d="M14 8h3V4h-3a6 6 0 0 0-6 6v2H5v4h3v8h4v-8h4l1-4h-5v-2a2 2 0 0 1 2-2Z"></path>
    </svg>
  ) : (
    <svg class="social-brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="5"></rect>
      <circle cx="12" cy="12" r="4"></circle>
      <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"></circle>
    </svg>
  )
}
