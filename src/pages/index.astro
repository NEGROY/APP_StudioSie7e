---
import Layout from "../layouts/Layout.astro";
import { mediaUrl } from "../config/media.js";
---
<Layout
  title="Studio Siete | Fotografía profesional en Cobán"
  description="Studio Siete crea fotografía profesional, sesiones y contenido visual para personas y negocios en Cobán."
>
  <div class="intro" id="intro" aria-label="Presentación de Studio Siete">
    <button class="intro__button" id="introButton" type="button">
      <img src={mediaUrl("ISOTIPO.png")} alt="Studio Siete" width="260" height="260" />
      <span>Descubrir Studio Siete</span>
    </button>
  </div>

  <section class="home-hero" aria-labelledby="homeTitle">
    <img
      class="home-hero__media"
      src={mediaUrl("ejemplos/sesion.jpg")}
      alt="Sesión fotográfica familiar realizada en estudio"
      fetchpriority="high"
    />
    <div class="home-hero__shade" aria-hidden="true"></div>
    <div class="home-hero__content reveal">
      <p class="kicker">Fotografía y contenido visual · Cobán</p>
      <h1 id="homeTitle">Studio Siete</h1>
      <p class="home-hero__lead">
        Imágenes que impulsan tu negocio y conservan tus momentos para siempre.
      </p>
      <div class="hero-actions">
        <a class="action action--gold" href="https://wa.me/50257479695" target="_blank" rel="noreferrer">
          Reservar una sesión
          <i data-lucide="arrow-right" aria-hidden="true"></i>
        </a>
        <a class="action action--light" href="/galeria">
          Ver galería
          <i data-lucide="camera" aria-hidden="true"></i>
        </a>
      </div>
    </div>
    <div class="home-hero__caption" aria-hidden="true">
      <span>Retrato</span>
      <span>Marca</span>
      <span>Celebracion</span>
    </div>
  </section>

  <section class="home-statement section-shell reveal" aria-labelledby="statementTitle">
    <p class="section-index">01 / Nuestro enfoque</p>
    <div>
      <h2 id="statementTitle">Cada imagen tiene un propósito.</h2>
      <p>
        Creamos fotografía profesional para comunicar el valor de una marca y preservar la emoción de una historia personal.
      </p>
    </div>
  </section>

  <section class="home-announcements" id="homeAnnouncements" aria-labelledby="announcementsTitle" hidden>
    <div class="section-shell section-heading section-heading--dark reveal">
      <div>
        <p class="kicker kicker--blue">Agenda del estudio</p>
        <h2 id="announcementsTitle">Anuncios vigentes.</h2>
      </div>
      <p class="section-note" id="announcementCount"></p>
    </div>
    <div class="home-announcement-grid section-shell" id="homeAnnouncementGrid" aria-live="polite"></div>
  </section>

  <section class="home-work" aria-labelledby="workTitle">
    <div class="section-shell section-heading reveal">
      <div>
        <p class="kicker kicker--blue">Lo que hacemos</p>
        <h2 id="workTitle">Producción visual con dirección y detalle.</h2>
      </div>
      <a class="text-link" href="/servicios">
        Explorar servicios
        <i data-lucide="arrow-right" aria-hidden="true"></i>
      </a>
    </div>

    <div class="work-grid section-shell">
      <a class="work-feature reveal" href="/galeria">
        <img src={mediaUrl("modelos/modelo-04.jpg")} alt="Retrato profesional en Studio Siete" loading="lazy" />
        <span>Retrato editorial</span>
        <strong>Personas con presencia.</strong>
      </a>
      <a class="work-feature reveal" href="/servicios">
        <img src={mediaUrl("ejemplos/producto.jpg")} alt="Fotografía de producto para una marca" loading="lazy" />
        <span>Contenido comercial</span>
        <strong>Marcas que se hacen visibles.</strong>
      </a>
      <a class="work-feature reveal" href="/galeria">
        <img src={mediaUrl("ejemplos/evento.jpg")} alt="Cobertura fotografica de un evento" loading="lazy" />
        <span>Eventos</span>
        <strong>Historias que permanecen.</strong>
      </a>
    </div>
  </section>

  <section class="home-cta reveal" aria-labelledby="homeCtaTitle">
    <p class="kicker">Tu próxima historia puede comenzar aquí</p>
    <h2 id="homeCtaTitle">Hagamos visible lo que importa.</h2>
    <a class="action action--blue" href="/contacto">
      Contactar al estudio
      <i data-lucide="arrow-right" aria-hidden="true"></i>
    </a>
  </section>

  <dialog class="promotion-dialog" id="promotionDialog" aria-labelledby="promotionDialogTitle">
    <button class="promotion-dialog__close" type="button" data-promotion-close aria-label="Cerrar promoción" title="Cerrar">
      <i data-lucide="x" aria-hidden="true"></i>
    </button>
    <div class="promotion-dialog__media" id="promotionDialogMedia"></div>
    <div class="promotion-dialog__content">
      <p class="kicker kicker--blue">Promoción vigente</p>
      <p class="promotion-dialog__dates" id="promotionDialogDates"></p>
      <h2 id="promotionDialogTitle"></h2>
      <p id="promotionDialogDescription"></p>
      <div class="promotion-dialog__actions">
        <a class="action action--blue" href="/promociones">
          Ver promociones
          <i data-lucide="arrow-right" aria-hidden="true"></i>
        </a>
        <button class="promotion-dialog__dismiss" type="button" data-promotion-close>Ahora no</button>
      </div>
    </div>
  </dialog>

  <script src="../scripts/home-notices.js"></script>
</Layout>
